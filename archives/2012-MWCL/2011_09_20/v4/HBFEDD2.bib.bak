@ARTICLE{Bachinger2005,
  author = {Bachinger, F. and Langer, U. and Sch\"oberl, J},
  title = {Numerical analysis of nonlinear multiharmonic eddy current problems},
  journal = {Numer. Math.},
  year = {2005},
  volume = {100},
  pages = {593-616},
  number = {4},
  month = {June},
  abstract = {Summary This work is devoted to non-linear eddy current problems and
	their numerical treatment by the so-called multiharmonic approach.
	Since the sources are usually alternating currents, we propose a
	truncated Fourier series expansion instead of a costly time-stepping
	scheme. Moreover, we suggest to introduce some regularization parameter
	that ensures unique solvability not only in the factor space of divergence-free
	functions, but also in the whole space H(curl). Finally, we provide
	a rigorous estimate for the total error that is due to the use of
	truncated Fourier series, the regularization technique and the spatial
	finite element discretization.},
  affiliation = {Spezialforschungsbereich SFB F013 “Numerical and Symbolic Scientific
	Computing” Johannes Kepler University Linz Austria},
  issn = {0029-599X},
  issue = {4},
  keyword = {Mathematics and Statistics},
  publisher = {Springer Berlin / Heidelberg}
}

