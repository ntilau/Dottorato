@ARTICLE{Guarnieri2009,
  author = {Guarnieri, Giacomo and Pelosi, Giuseppe and Rossi, Lorenzo and Selleri,
	Stefano},
  title = {A domain decomposition technique for finite element based parametric
	sweep and tolerance analyses of microwave passive devices},
  journal = {International Journal of RF and Microwave Computer-Aided Engineering},
  year = {2009},
  volume = {19},
  pages = {328--337},
  number = {3},
  abstract = {Abstract A domain decomposition approach is here applied to the finite
	element solution of a multiport waveguide passive device. The approach
	allows separating the problem in multiple, coupled subproblems which
	can be solved individually. By appropriately defining one of these
	subdomains as containing all the possible variations to be studied
	it is hence possible to restrict the tolerance analysis to this latter,
	smaller domain. Numerical results showing the gain in computing time
	are presented. Â© 2008 Wiley Periodicals, Inc. Int J RF and Microwave
	CAE, 2009.},
  doi = {10.1002/mmce.20346},
  issn = {1099-047X},
  keywords = {finite element method, domain decomposition, tolerance analysis, microwave
	devices},
  publisher = {Wiley Subscription Services, Inc., A Wiley Company},
  url = {http://dx.doi.org/10.1002/mmce.20346}
}

